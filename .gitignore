# ─── Secrets (never commit) ────────────────────────────────────────────────
.env
.env.*
!.env.example
secret_key.py
*.key
*.pem
*.keystore
*.jks
keystore.properties
*.p12
*.pfx

# ─── Patient / runtime data ────────────────────────────────────────────────
# The desktop app stores its SQLite DB here at runtime. Never commit it.
User_data/
apps/desktop/User_data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
exports/
data/private/
private_data/

# ─── Legacy / generated model artifacts ────────────────────────────────────
# Pickle/joblib models execute arbitrary code on load. They are build
# artifacts now; the shippable model is shared/model/model.onnx.
*.pkl
*.joblib
*.h5
*.pt
*.pth

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# ─── Rust ──────────────────────────────────────────────────────────────────
target/
**/target/
core/rust/target/

# ─── Android / Gradle ──────────────────────────────────────────────────────
.gradle/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
apps/android/app/release/
apps/android/app/debug/
