# ─── SURAS environment template ─────────────────────────────────────────────
# Copy to .env and fill in locally. NEVER commit the filled-in .env: it is
# git-ignored on purpose. No secret belongs in source control.

# Optional: override where the desktop app reads the shared contract files
# (version.json, preprocessing.json, swbra_spec.json, model/). Defaults to the
# repository root (or the PyInstaller bundle's shared/ directory).
# SURAS_SHARED_DIR=

# Optional: override the per-user writable data directory that holds the
# encrypted patient database and the local access-password file.
# Windows: %APPDATA%\UlcerRiskAI   macOS: ~/Library/Application Support/UlcerRiskAI
# Linux:   $XDG_DATA_HOME/ulcer-risk-ai or ~/.local/share/ulcer-risk-ai
# SURAS_DATA_DIR=

# ─── Release signing (CI only) ──────────────────────────────────────────────
# These are supplied to the release workflow as GitHub Actions secrets, never
# as files in the repository. Listed here so the required set is documented.
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
